{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "timezone": "America/Los_Angeles",
  "platformAutomerge": true,
  "constraints": {
    "node": "22"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0-5 1 * *"]
  },
  "packageRules": [
    {
      "description": "One PR a week for every non-major update. It merges itself once the required checks pass.",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "schedule": ["* 0-5 * * 1"],
      "automerge": true
    },
    {
      "description": "A major update opens only once a maintainer ticks it on the Dependency Dashboard, and never merges itself.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Hold Node at 22: the runtime and @types/node. Lift this rule, the next one, and constraints.node together.",
      "matchDatasources": ["node-version", "npm"],
      "matchPackageNames": ["node", "@types/node"],
      "allowedVersions": "<23"
    },
    {
      "description": "Hold Node at 22: keep @tsconfig/node22, and do not replace it with a later @tsconfig/nodeNN.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@tsconfig/node*"],
      "matchUpdateTypes": ["replacement"],
      "enabled": false
    },
    {
      "description": "Hold ESLint at 9 until @cyc-seattle/ts-config and typescript-eslint support ESLint 10.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["eslint", "@eslint/js"],
      "allowedVersions": "<10"
    }
  ]
}
